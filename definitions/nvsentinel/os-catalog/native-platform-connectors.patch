diff --git a/distros/debian/build-platform-connectors.sh b/distros/debian/build-platform-connectors.sh
new file mode 100644
index 0000000..2d8aaa9
--- /dev/null
+++ b/distros/debian/build-platform-connectors.sh
@@ -0,0 +1,35 @@
+#!/bin/sh
+# Copyright (c) 2026, NVIDIA CORPORATION. All rights reserved.
+# SPDX-License-Identifier: Apache-2.0
+set -eu
+umask 022
+arch="$1"
+distribution="$2"
+case "$distribution" in
+    ubuntu-24.04) ubuntu_version=24.04 ;;
+    ubuntu-26.04) ubuntu_version=26.04 ;;
+    *) printf 'Unsupported Ubuntu target: %s\n' "$distribution" >&2; exit 1 ;;
+esac
+. /etc/os-release
+test "$ID" = ubuntu
+test "$VERSION_ID" = "$ubuntu_version"
+: "${SOURCE_DATE_EPOCH:?compiled source date is required}"
+control="/src/distros/debian/platform-connectors/control.$arch"
+if [ ! -f "$control" ]; then
+    printf 'Provide the reviewed Debian control file %s, including Maintainer and Version, in the pinned recipe patch.\n' "$control" >&2
+    exit 1
+fi
+test "$(go env GOVERSION)" = go1.27.0
+test "$(go env GOARCH)" = "$arch"
+test "$(dpkg --print-architecture)" = "$arch"
+test -f /src/platform-connectors/vendor/modules.txt
+out=/src/nvkr-output
+root="$out/package"
+mkdir -p "$root/DEBIAN" "$root/usr/lib/nvsentinel/bin" "$root/usr/lib/systemd/system" "$root/usr/share/doc/nvsentinel-platform-connectors" "$out/go-cache"
+cp "$control" "$root/DEBIAN/control"
+cd /src/platform-connectors
+CGO_ENABLED=0 GOTOOLCHAIN=local GOWORK=off GOPROXY=off GOSUMDB=off GOCACHE="$out/go-cache" go build -mod=vendor -trimpath -buildvcs=false -o "$root/usr/lib/nvsentinel/bin/platform-connectors" .
+install -m 0644 /src/distros/debian/platform-connectors/nvsentinel-platform-connector.service "$root/usr/lib/systemd/system/"
+install -m 0644 /src/LICENSE "$root/usr/share/doc/nvsentinel-platform-connectors/copyright"
+find "$root" -exec touch -h -d "@$SOURCE_DATE_EPOCH" {} +
+exec dpkg-deb --root-owner-group --uniform-compression -Zgzip -z9 --build "$root" "$out/nvsentinel-platform-connectors_$arch.deb"

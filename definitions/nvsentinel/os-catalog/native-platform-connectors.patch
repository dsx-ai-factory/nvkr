diff --git a/distros/debian/platform-connectors/nvsentinel-platform-connector.service b/distros/debian/platform-connectors/nvsentinel-platform-connector.service
new file mode 100644
index 0000000..84950ae
--- /dev/null
+++ b/distros/debian/platform-connectors/nvsentinel-platform-connector.service
@@ -0,0 +1,23 @@
+# Copyright (c) 2026, NVIDIA CORPORATION. All rights reserved.
+# SPDX-License-Identifier: Apache-2.0
+[Unit]
+Description=NVSentinel node-local platform connector
+Wants=network-online.target
+After=network-online.target
+ConditionPathExists=/etc/nvsentinel/node.env
+ConditionPathExists=/etc/nvsentinel/platform-connector.json
+ConditionPathExists=/etc/nvsentinel/api.kubeconfig
+
+[Service]
+Type=simple
+EnvironmentFile=/etc/nvsentinel/node.env
+ExecStart=/usr/lib/nvsentinel/bin/platform-connectors --mode=node-local --config=/etc/nvsentinel/platform-connector.json --socket=/run/nvsentinel/nvsentinel.sock --kubeconfig=/etc/nvsentinel/api.kubeconfig --metrics-port=${PC_METRICS_PORT}
+RuntimeDirectory=nvsentinel
+RuntimeDirectoryMode=0755
+RuntimeDirectoryPreserve=yes
+StateDirectory=nvsentinel
+StateDirectoryMode=0755
+Restart=on-failure
+
+[Install]
+WantedBy=multi-user.target

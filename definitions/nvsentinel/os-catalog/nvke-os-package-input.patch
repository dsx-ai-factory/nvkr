+    def test_missing_network_config_does_not_publish_archive(self):
+        for name in ("99-disable-network-config.cfg", "00-dhcp-all.yaml"):
+            path = self.source_files / name
+            saved = path.read_bytes()
+            path.unlink()
+            try:
+                for existing in (False, True):
+                    with self.subTest(name=name, existing=existing):
+                        output = self.root / f"missing-{name}-{existing}.tar"
+                        if existing:
+                            output.write_bytes(b"prior output")
+                        result = self.run_compose(output)
+                        self.assertNotEqual(result.returncode, 0)
+                        self.assertIn(name, result.stderr)
+                        if existing:

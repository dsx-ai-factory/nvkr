{
  "apiVersion": "nkd.dev/definition/v5",
  "catalog": {
    "base": "./cli-catalog"
  },
  "kind": "Definition",
  "metadata": {
    "name": "nke-local-dev-arm64-components",
    "description": "Local ARM64 CLI, controller, source-built providers, tools, five charts and twelve acquired dependency images; not a full source-built NKE distribution; no publication or signing."
  },
  "outputs": [
    {
      "catalog": {"base": "./capnico-catalog"},
      "components": ["capnico-controller"],
      "format": "oci",
      "name": "capnico-controller-arm64",
      "platform": "linux/arm64"
    },
    {
      "catalog": {"base": "../nke-controller/catalog"},
      "components": ["cluster-api-provider-provisioned"],
      "format": "oci",
      "name": "cluster-api-provider-provisioned-arm64",
      "platform": "linux/arm64"
    },
    {
      "catalog": {
        "base": "../nke-controller/catalog"
      },
      "components": [
        "nke-controller-chart"
      ],
      "format": "helm-oci",
      "helm": {
        "images": {
          "controller": "cwe"
        }
      },
      "name": "controller-chart",
      "platform": "linux/arm64"
    },
    {
      "catalog": {
        "base": "../nke-m2/image-catalog"
      },
      "components": [
        "csi-node-driver-registrar-image"
      ],
      "format": "oci",
      "name": "csi-node-driver-registrar-image-arm64",
      "platform": "linux/arm64"
    },
    {
      "catalog": {
        "base": "../nke-controller/catalog"
      },
      "components": [
        "nke-controller"
      ],
      "format": "oci",
      "name": "cwe",
      "platform": "linux/arm64"
    },
    {
      "components": [
        "nkectl-arm64"
      ],
      "format": "executable",
      "name": "nkectl",
      "platform": "linux/arm64"
    },
    {
      "catalog": {
        "base": "./operator-catalog"
      },
      "components": [
        "helm",
        "kubectl"
      ],
      "format": "executable",
      "name": "operator-tools",
      "platform": "linux/arm64"
    },
    {
      "catalog": {
        "base": "../nke-controller/catalog"
      },
      "components": [
        "postgresql-chart"
      ],
      "format": "helm-oci",
      "name": "postgresql",
      "platform": "linux/arm64"
    },
    {
      "catalog": {
        "base": "../nke-m2/image-catalog"
      },
      "components": [
        "postgresql-image"
      ],
      "format": "oci",
      "name": "postgresql-image-arm64",
      "platform": "linux/arm64"
    },
    {
      "catalog": {
        "base": "../nke-m2/image-catalog"
      },
      "components": [
        "spiffe-csi-image"
      ],
      "format": "oci",
      "name": "spiffe-csi-image-arm64",
      "platform": "linux/arm64"
    },
    {
      "catalog": {
        "base": "../nke-controller/catalog"
      },
      "components": [
        "spire-chart"
      ],
      "format": "helm-oci",
      "name": "spire",
      "platform": "linux/arm64"
    },
    {
      "catalog": {
        "base": "../nke-m2/image-catalog"
      },
      "components": [
        "spire-agent-image"
      ],
      "format": "oci",
      "name": "spire-agent-image-arm64",
      "platform": "linux/arm64"
    },
    {
      "catalog": {
        "base": "../nke-m2/image-catalog"
      },
      "components": [
        "spire-bash-image"
      ],
      "format": "oci",
      "name": "spire-bash-image-arm64",
      "platform": "linux/arm64"
    },
    {
      "catalog": {
        "base": "../nke-m2/image-catalog"
      },
      "components": [
        "spire-controller-manager-image"
      ],
      "format": "oci",
      "name": "spire-controller-manager-image-arm64",
      "platform": "linux/arm64"
    },
    {
      "catalog": {
        "base": "../nke-controller/catalog"
      },
      "components": [
        "spire-crds-chart"
      ],
      "format": "helm-oci",
      "name": "spire-crds",
      "platform": "linux/arm64"
    },
    {
      "catalog": {
        "base": "../nke-m2/image-catalog"
      },
      "components": [
        "spire-oidc-image"
      ],
      "format": "oci",
      "name": "spire-oidc-image-arm64",
      "platform": "linux/arm64"
    },
    {
      "catalog": {
        "base": "../nke-m2/image-catalog"
      },
      "components": [
        "spire-server-image"
      ],
      "format": "oci",
      "name": "spire-server-image-arm64",
      "platform": "linux/arm64"
    },
    {
      "catalog": {
        "base": "../nke-m2/image-catalog"
      },
      "components": [
        "spire-tpm-server-image"
      ],
      "format": "oci",
      "name": "spire-tpm-server-image-arm64",
      "platform": "linux/arm64"
    },
    {
      "catalog": {
        "base": "../nke-controller/catalog"
      },
      "components": [
        "temporal-chart"
      ],
      "format": "helm-oci",
      "name": "temporal",
      "platform": "linux/arm64"
    },
    {
      "catalog": {
        "base": "../nke-m2/image-catalog"
      },
      "components": [
        "temporal-admin-tools-image"
      ],
      "format": "oci",
      "name": "temporal-admin-tools-image-arm64",
      "platform": "linux/arm64"
    },
    {
      "catalog": {
        "base": "../nke-m2/image-catalog"
      },
      "components": [
        "temporal-server-image"
      ],
      "format": "oci",
      "name": "temporal-server-image-arm64",
      "platform": "linux/arm64"
    },
    {
      "catalog": {
        "base": "../nke-m2/image-catalog"
      },
      "components": [
        "temporal-ui-image"
      ],
      "format": "oci",
      "name": "temporal-ui-image-arm64",
      "platform": "linux/arm64"
    }
  ]
}

{
  "apiVersion": "nkd.dev/environment/v1",
  "kind": "Environment",
  "metadata": {
    "name": "nke-local-dev-arm64-podman",
    "description": "Local ARM64 build/acquisition with raw QCOW2 export; no publication, signing or production evidence."
  },
  "utilityContainer": "golang@sha256:5bc7f572bbaa98885a3a1fd9c0aa76b59e3e14e8628bfc316bbfd0c701e4818c",
  "utilityPlatform": "linux/arm64",
  "executionClasses": [
    {
      "name": "linux-arm64-tcg-laptop-podman",
      "runsOn": "local-laptop-podman-arm64-tcg",
      "hostPlatform": "linux/arm64",
      "resources": {
        "cpuMillis": 8000,
        "memoryMiB": 10240,
        "ephemeralStorageMiB": 65536
      },
      "maxTimeoutSeconds": 21600
    }
  ],
  "runtime": {
    "runtime": "podman",
    "buildNetworkPolicy": "producer-declared"
  }
}

+#!/bin/sh
+# SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+# SPDX-License-Identifier: Apache-2.0
+
+# NKD applies this reviewed source patch before executing the producer.
+# Only the declared bin output directory is writable during this build.
+set -eu
+test "$#" = 1
+test "$1" = arm64
+fixture=controller/test/fixtures
+context=bin/profiles-context
+profile="$context/profiles/osProfiles/nke-local-26-04-arm64-plain"
+mkdir -p "$profile" "$context/profiles/configProfiles"
+cp "$fixture/Dockerfile" "$context/Dockerfile"
+cp -R "$fixture/runbooks" "$context/runbooks"
+cp "$fixture/profiles/configProfiles/nico-vms-cp.yaml" \
+  "$fixture/profiles/configProfiles/nico-vms-worker.yaml" "$context/profiles/configProfiles/"
+cp "$fixture/profiles/osProfiles/nke-nico-vms-24.04-arm64-fde/userData.tmpl" "$profile/userData.tmpl"
+cp "$fixture/nkd-local/ipxeScript" "$profile/ipxeScript"
+cp "$fixture/nkd-local/metadata.yaml" "$context/profiles/osProfiles/metadata.yaml"
+buildctl-daemonless.sh build --frontend dockerfile.v0 \
+  --local context=/src/bin/profiles-context --local dockerfile=/src/bin/profiles-context \
+  --opt platform=linux/arm64 --opt force-network-mode=none \
+  --opt "build-arg:SOURCE_DATE_EPOCH=$SOURCE_DATE_EPOCH" \
+  --output type=oci,dest=/src/bin/nke-local-profiles-arm64.oci.tar,oci-mediatypes=true

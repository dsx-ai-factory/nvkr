{
  "apiVersion": "nkd.dev/environment/v1",
  "kind": "Environment",
  "metadata": {
    "name": "nke-laptop-arm64-podman",
    "description": "Local 21-output ARM64 build/acquisition with raw QCOW2 export; no publication, signing or production evidence."
  },
  "utilityContainer": "golang@sha256:6c2a5538f964f1c82f97ad14988bf05de100d922d159d0e398b54c7b0ca0c6c9",
  "utilityPlatform": "linux/arm64",
  "executionClasses": [
    {
      "name": "linux-arm64-tcg-laptop-podman",
      "runsOn": "local-laptop-podman-arm64-tcg",
      "hostPlatform": "linux/arm64",
      "resources": {
        "cpuMillis": 8000,
        "memoryMiB": 10240,
        "ephemeralStorageMiB": 65536
      },
      "maxTimeoutSeconds": 21600
    }
  ],
  "runtime": {
    "runtime": "podman",
    "buildNetworkPolicy": "producer-declared"
  }
}

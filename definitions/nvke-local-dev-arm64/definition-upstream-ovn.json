{
  "apiVersion": "nvkr.dev/definition/v5",
  "catalog": {
    "base": "./cli-catalog"
  },
  "kind": "Definition",
  "metadata": {
    "name": "nvke-local-dev-arm64-upstream-ovn",
    "description": "Explicit diagnostic upstream OVN v1.4.0 alternative; 29 local ARM64 outputs, source-built upstream image/chart and matching disk CNI packages. NVIDIA remains the default. No publication, signing, Kubernetes compatibility, FIPS/STIG or qualification claim."
  },
  "outputs": [
    {
      "catalog": {
        "base": "./capnico-catalog"
      },
      "components": [
        "capnico-controller"
      ],
      "format": "oci",
      "name": "capnico-controller-arm64",
      "platform": "linux/arm64"
    },
    {
      "catalog": {
        "base": "../nvke-controller/catalog"
      },
      "components": [
        "cluster-api-provider-provisioned"
      ],
      "format": "oci",
      "name": "cluster-api-provider-provisioned-arm64",
      "platform": "linux/arm64"
    },
    {
      "catalog": {
        "base": "./site-catalog"
      },
      "components": [
        "nvke-controller-chart"
      ],
      "format": "helm-oci",
      "helm": {
        "images": {
          "controller": "cwe"
        }
      },
      "name": "controller-chart",
      "platform": "linux/arm64"
    },
    {
      "catalog": {
        "base": "./upstream-ovn-profiles-catalog"
      },
      "components": [
        "nvke-local-profiles"
      ],
      "format": "oci",
      "name": "controller-profiles-upstream-ovn",
      "platform": "linux/arm64"
    },
    {
      "catalog": {
        "base": "../nvke-m2/image-catalog"
      },
      "components": [
        "csi-node-driver-registrar-image"
      ],
      "format": "oci",
      "name": "csi-node-driver-registrar-image-arm64",
      "platform": "linux/arm64"
    },
    {
      "catalog": {
        "base": "./site-catalog"
      },
      "components": [
        "nvke-controller"
      ],
      "format": "oci",
      "name": "cwe",
      "platform": "linux/arm64"
    },
    {
      "catalog": {
        "base": "./tools-catalog"
      },
      "components": [
        "clusterctl",
        "helm",
        "kind",
        "kubectl",
        "oras"
      ],
      "format": "executable",
      "name": "installer-tools-arm64",
      "platform": "linux/arm64"
    },
    {
      "catalog": {
        "base": "./simulator-catalog"
      },
      "components": [
        "nico-sim",
        "nico-sim-runtime-assets",
        "nico-simctl"
      ],
      "format": "executable",
      "name": "nicosim-tools-arm64",
      "platform": "linux/arm64"
    },
    {
      "catalog": {
        "base": "./site-catalog"
      },
      "components": [
        "nktp-chart"
      ],
      "format": "helm-oci",
      "name": "nktp",
      "platform": "linux/arm64"
    },
    {
      "catalog": {
        "base": "../nvke-m2/os-catalog",
        "overlays": [
          "./os-tcg.json",
          "./os-upstream-ovn.json"
        ]
      },
      "components": [
        "nvke-agent",
        "nvke-cni-calico",
        "nvke-cni-ovn",
        "nvke-image-inputs",
        "nvke-kubeadm-distro",
        "nvke-node-image",
        "nvke-patched-installer-iso",
        "nvke-spire-agent",
        "ovn-kube-ubuntu",
        "ovn-kubernetes-chart",
        "ubuntu-installer-iso"
      ],
      "format": "disk-image",
      "name": "nvke-node-image-upstream-ovn-arm64",
      "platform": "linux/arm64"
    },
    {
      "catalog": {
        "base": "./site-catalog"
      },
      "components": [
        "nvkectl"
      ],
      "format": "executable",
      "name": "nvkectl",
      "platform": "linux/arm64"
    },
    {
      "catalog": {
        "base": "./operator-catalog"
      },
      "components": [
        "helm",
        "kubectl"
      ],
      "format": "executable",
      "name": "operator-tools",
      "platform": "linux/arm64"
    },
    {
      "catalog": {
        "base": "../nvke-controller/catalog"
      },
      "components": [
        "postgresql-chart"
      ],
      "format": "helm-oci",
      "name": "postgresql",
      "platform": "linux/arm64"
    },
    {
      "catalog": {
        "base": "../nvke-m2/image-catalog"
      },
      "components": [
        "postgresql-image"
      ],
      "format": "oci",
      "name": "postgresql-image-arm64",
      "platform": "linux/arm64"
    },
    {
      "catalog": {
        "base": "../nvke-m2/image-catalog"
      },
      "components": [
        "spiffe-csi-image"
      ],
      "format": "oci",
      "name": "spiffe-csi-image-arm64",
      "platform": "linux/arm64"
    },
    {
      "catalog": {
        "base": "../nvke-controller/catalog"
      },
      "components": [
        "spire-chart"
      ],
      "format": "helm-oci",
      "name": "spire",
      "platform": "linux/arm64"
    },
    {
      "catalog": {
        "base": "../nvke-m2/image-catalog"
      },
      "components": [
        "spire-agent-image"
      ],
      "format": "oci",
      "name": "spire-agent-image-arm64",
      "platform": "linux/arm64"
    },
    {
      "catalog": {
        "base": "../nvke-m2/image-catalog"
      },
      "components": [
        "spire-bash-image"
      ],
      "format": "oci",
      "name": "spire-bash-image-arm64",
      "platform": "linux/arm64"
    },
    {
      "catalog": {
        "base": "../nvke-m2/image-catalog"
      },
      "components": [
        "spire-controller-manager-image"
      ],
      "format": "oci",
      "name": "spire-controller-manager-image-arm64",
      "platform": "linux/arm64"
    },
    {
      "catalog": {
        "base": "../nvke-controller/catalog"
      },
      "components": [
        "spire-crds-chart"
      ],
      "format": "helm-oci",
      "name": "spire-crds",
      "platform": "linux/arm64"
    },
    {
      "catalog": {
        "base": "../nvke-m2/image-catalog"
      },
      "components": [
        "spire-oidc-image"
      ],
      "format": "oci",
      "name": "spire-oidc-image-arm64",
      "platform": "linux/arm64"
    },
    {
      "catalog": {
        "base": "../nvke-m2/image-catalog"
      },
      "components": [
        "spire-server-image"
      ],
      "format": "oci",
      "name": "spire-server-image-arm64",
      "platform": "linux/arm64"
    },
    {
      "catalog": {
        "base": "../nvke-m2/image-catalog"
      },
      "components": [
        "spire-tpm-server-image"
      ],
      "format": "oci",
      "name": "spire-tpm-server-image-arm64",
      "platform": "linux/arm64"
    },
    {
      "catalog": {
        "base": "../nvke-controller/catalog"
      },
      "components": [
        "temporal-chart"
      ],
      "format": "helm-oci",
      "name": "temporal",
      "platform": "linux/arm64"
    },
    {
      "catalog": {
        "base": "../nvke-m2/image-catalog"
      },
      "components": [
        "temporal-admin-tools-image"
      ],
      "format": "oci",
      "name": "temporal-admin-tools-image-arm64",
      "platform": "linux/arm64"
    },
    {
      "catalog": {
        "base": "../nvke-m2/image-catalog"
      },
      "components": [
        "temporal-server-image"
      ],
      "format": "oci",
      "name": "temporal-server-image-arm64",
      "platform": "linux/arm64"
    },
    {
      "catalog": {
        "base": "../nvke-m2/image-catalog"
      },
      "components": [
        "temporal-ui-image"
      ],
      "format": "oci",
      "name": "temporal-ui-image-arm64",
      "platform": "linux/arm64"
    },
    {
      "catalog": {
        "base": "./upstream-ovn-catalog"
      },
      "components": [
        "ovn-kubernetes-chart"
      ],
      "format": "helm-oci",
      "helm": {
        "images": {
          "ovn": "upstream-ovn-image-arm64"
        }
      },
      "name": "upstream-ovn-chart-arm64",
      "platform": "linux/arm64"
    },
    {
      "catalog": {
        "base": "./upstream-ovn-catalog"
      },
      "components": [
        "ovn-kube-ubuntu"
      ],
      "format": "oci",
      "name": "upstream-ovn-image-arm64",
      "platform": "linux/arm64"
    }
  ]
}

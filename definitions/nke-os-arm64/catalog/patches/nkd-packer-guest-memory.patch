 }
diff --git a/os-image/packer/variables.pkr.hcl b/os-image/packer/variables.pkr.hcl
--- a/os-image/packer/variables.pkr.hcl
+++ b/os-image/packer/variables.pkr.hcl
@@ -134,6 +134,17 @@ variable "cpu_model" {
   description = "QEMU CPU model. Use host with KVM and max with TCG emulation."
 }
 
+variable "guest_memory_mib" {
+  type        = number
+  default     = 8192
+  description = "Guest memory in MiB."
+
+  validation {
+    condition     = var.guest_memory_mib >= 1
+    error_message = "The guest_memory_mib value must be at least 1."
+  }
+}
+
 variable "cpus" {
   type        = number
   default     = 4
   description = "Guest vCPU count."

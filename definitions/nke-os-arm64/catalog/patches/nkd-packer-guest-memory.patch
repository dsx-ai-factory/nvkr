diff --git a/os-image/packer/nke-node-fde.pkr.hcl b/os-image/packer/nke-node-fde.pkr.hcl
--- a/os-image/packer/nke-node-fde.pkr.hcl
+++ b/os-image/packer/nke-node-fde.pkr.hcl
@@ -61,7 +61,7 @@ source "qemu" "nke-fde" {
   vm_name          = "nke-node.qcow2"
   output_directory = "${var.output_directory}/fde"

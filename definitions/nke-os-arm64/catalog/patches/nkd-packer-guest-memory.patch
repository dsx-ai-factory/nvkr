-  memory           = 8192
+  memory           = var.guest_memory_mib
   cpus             = var.cpus
   net_device       = "virtio-net"
 }
diff --git a/os-image/packer/nke-node-non-fde.pkr.hcl b/os-image/packer/nke-node-non-fde.pkr.hcl
--- a/os-image/packer/nke-node-non-fde.pkr.hcl

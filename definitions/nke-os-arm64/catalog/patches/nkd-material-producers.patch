diff --git a/os-image/packer/scripts/nkd-compose-image-inputs.py b/os-image/packer/scripts/nkd-compose-image-inputs.py
new file mode 100755
index 00000000..895529c7
--- /dev/null
+++ b/os-image/packer/scripts/nkd-compose-image-inputs.py
@@ -0,0 +1,149 @@
+#!/usr/bin/env python3
+# SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+# SPDX-License-Identifier: Apache-2.0
+
+"""Compose NKD-authenticated NKE package outputs into Packer image inputs."""
+
+from __future__ import annotations
+
+import os
+import pathlib
+import shutil
+import stat
+import subprocess
+import tarfile
+import tempfile
+
+
+INPUT_ROOT = pathlib.Path("/nkd/inputs/materials")
+OUTPUT_ROOT = pathlib.Path("/src/nkd-output")
+SOURCE_FILES = pathlib.Path("/src/os-image/files")
+ARCHIVES = (
+    "calico",
+    "kubeadm-distro",
+    "ovn",
+    "spire-agent",
+)
+
+
+def require_regular(path: pathlib.Path, label: str) -> os.stat_result:
+    try:
+        info = path.lstat()
+    except OSError as exc:
+        raise SystemExit(f"{label}: cannot inspect {path}: {exc}") from exc
+    if not stat.S_ISREG(info.st_mode):
+        raise SystemExit(f"{label}: {path} is not one regular file")
+    return info
+
+
+def archive_debs(path: pathlib.Path) -> list[tuple[str, bytes]]:
+    require_regular(path, "package archive")
+    result: list[tuple[str, bytes]] = []
+    try:
+        with tarfile.open(path, mode="r:") as archive:
+            for member in archive.getmembers():
+                name = member.name.removeprefix("./")
+                if member.isdir() and name in ("", "."):
+                    continue
+                if (
+                    not member.isreg()
+                    or pathlib.PurePosixPath(name).name != name
+                    or not name.endswith(".deb")
+                ):
+                    raise SystemExit(
+                        f"package archive {path} has unsafe or unexpected member {member.name!r}"
+                    )
+                source = archive.extractfile(member)
+                if source is None:
+                    raise SystemExit(f"package archive {path} cannot read {member.name!r}")
+                result.append((name, source.read()))
+    except (OSError, tarfile.TarError) as exc:
+        raise SystemExit(f"package archive {path} is invalid: {exc}") from exc
+    if not result:
+        raise SystemExit(f"package archive {path} contains no Debian packages")
+    return result
+
+
+def install_file(source: pathlib.Path, destination: pathlib.Path, mode: int) -> None:
+    require_regular(source, "source file")
+    with source.open("rb") as src, destination.open("xb") as dst:
+        shutil.copyfileobj(src, dst)
+    destination.chmod(mode)
+
+
+def main() -> None:
+    epoch_text = os.environ.get("SOURCE_DATE_EPOCH", "")
+    try:
+        epoch = int(epoch_text)
+    except ValueError as exc:
+        raise SystemExit("SOURCE_DATE_EPOCH must be a positive integer") from exc
+    if epoch <= 0:
+        raise SystemExit("SOURCE_DATE_EPOCH must be a positive integer")
+
+    OUTPUT_ROOT.mkdir(mode=0o755, parents=True, exist_ok=True)
+    with tempfile.TemporaryDirectory(prefix=".image-inputs.", dir=OUTPUT_ROOT) as temporary:
+        stage = pathlib.Path(temporary) / "root"
+        debs = stage / "debs"
+        debs.mkdir(mode=0o755, parents=True)
+
+        install_file(INPUT_ROOT / "agent", stage / "nke-agent.deb", 0o644)
+        install_file(
+            SOURCE_FILES / "nke-agent-spire.conf",
+            stage / "nke-agent-spire.conf",
+            0o644,
+        )
+        install_file(
+            SOURCE_FILES / "wait-spiffe-socket.sh",
+            stage / "wait-spiffe-socket.sh",
+            0o755,
+        )
+
+        names: set[str] = set()
+        for binding in ARCHIVES:
+            for name, content in archive_debs(INPUT_ROOT / binding):
+                if name in names:
+                    raise SystemExit(f"duplicate Debian package filename {name!r}")
+                names.add(name)
+                destination = debs / name
+                destination.write_bytes(content)
+                destination.chmod(0o644)
+
+        environment = os.environ.copy()
+        environment.update({"LC_ALL": "C", "LANG": "C", "TZ": "UTC"})
+        index = subprocess.run(
+            ["dpkg-scanpackages", ".", "/dev/null"],
+            cwd=debs,
+            env=environment,
+            check=True,
+            stdin=subprocess.DEVNULL,
+            stdout=subprocess.PIPE,
+        ).stdout
+        (debs / "Packages").write_bytes(index)
+        (debs / "Packages").chmod(0o644)
+
+        staged_output = pathlib.Path(temporary) / "image-inputs.tar"
+        subprocess.run(
+            [
+                "tar",
+                "--sort=name",
+                f"--mtime=@{epoch}",
+                "--owner=0",
+                "--group=0",
+                "--numeric-owner",
+                "-C",
+                str(stage),
+                "-cf",
+                str(staged_output),
+                ".",
+            ],
+            check=True,
+            stdin=subprocess.DEVNULL,
+        )
+        destination = OUTPUT_ROOT / "image-inputs.tar"
+        if destination.is_symlink():
+            raise SystemExit(f"refusing symlink output {destination}")
+        os.replace(staged_output, destination)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/os-image/packer/scripts/nkd-patch-installer-iso.sh b/os-image/packer/scripts/nkd-patch-installer-iso.sh
new file mode 100755
index 00000000..6c5a950d
--- /dev/null
+++ b/os-image/packer/scripts/nkd-patch-installer-iso.sh
@@ -0,0 +1,63 @@
+#!/usr/bin/env bash
+# SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+# SPDX-License-Identifier: Apache-2.0
+
+set -euo pipefail
+
+readonly source_iso=/nkd/inputs/materials/installer-source
+readonly output_root=/src/nkd-output
+readonly output_iso=${output_root}/installer.iso
+
+for tool in 7z awk grep mv sed xorriso; do
+  command -v "${tool}" >/dev/null 2>&1 || {
+    echo "nkd-patch-installer-iso: ${tool} is required" >&2
+    exit 1
+  }
+done
+
+if [[ ! -f "${source_iso}" || -L "${source_iso}" ]]; then
+  echo "nkd-patch-installer-iso: source is not one regular file: ${source_iso}" >&2
+  exit 1
+fi
+mkdir -p "${output_root}"
+if [[ ! -d "${output_root}" || -L "${output_root}" ]]; then
+  echo "nkd-patch-installer-iso: output root is unsafe: ${output_root}" >&2
+  exit 1
+fi
+if [[ -L "${output_iso}" ]]; then
+  echo "nkd-patch-installer-iso: refusing symlink output: ${output_iso}" >&2
+  exit 1
+fi
+
+work="$(mktemp -d "${output_root}/.installer.XXXXXX")"
+cleanup() {
+  rm -rf -- "${work}"
+}
+trap cleanup EXIT HUP INT TERM
+
+7z e -y -o"${work}" "${source_iso}" boot/grub/grub.cfg >/dev/null
+readonly grub_cfg=${work}/grub.cfg
+if [[ ! -f "${grub_cfg}" || -L "${grub_cfg}" ]]; then
+  echo "nkd-patch-installer-iso: ISO has no regular boot/grub/grub.cfg" >&2
+  exit 1
+fi
+timeout_count="$(grep -Ec '^set timeout=' "${grub_cfg}" || true)"
+if [[ "${timeout_count}" != 1 ]]; then
+  echo "nkd-patch-installer-iso: expected one GRUB timeout, found ${timeout_count}" >&2
+  exit 1
+fi
+sed 's/^set timeout=.*/set timeout=300/' "${grub_cfg}" >"${work}/grub.cfg.patched"
+if [[ "$(grep -Ec '^set timeout=300$' "${work}/grub.cfg.patched" || true)" != 1 ]]; then
+  echo "nkd-patch-installer-iso: GRUB timeout transform failed" >&2
+  exit 1
+fi
+
+xorriso -indev "${source_iso}" -outdev "${work}/installer.iso" \
+  -boot_image any replay \
+  -update "${work}/grub.cfg.patched" /boot/grub/grub.cfg \
+  -- -commit >/dev/null
+if [[ ! -s "${work}/installer.iso" || -L "${work}/installer.iso" ]]; then
+  echo "nkd-patch-installer-iso: xorriso produced no regular ISO" >&2
+  exit 1
+fi
+mv -f -- "${work}/installer.iso" "${output_iso}"

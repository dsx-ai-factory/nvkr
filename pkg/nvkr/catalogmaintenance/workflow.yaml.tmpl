# Generated by nvkr catalog update-ci. Review before installing in .github/workflows/.
# Candidate validation is diagnostic; production signing/release acceptance is separate.
name: Catalog maintenance [[.Config.Name]]
on:
  workflow_dispatch: {}
[[if .Config.Schedule]]  schedule:
    - cron: '[[.Config.Schedule]]'
[[end]]permissions:
  contents: read
concurrency:
  group: catalog-maintenance-[[.Config.Name]]
  cancel-in-progress: false
jobs:
  candidate:
    if: github.ref == format('refs/heads/{0}', github.event.repository.default_branch)
    runs-on: ubuntu-24.04
    timeout-minutes: 120
    outputs:
      changed: ${{ steps.refresh.outputs.changed }}
    env:
      GOTOOLCHAIN: local
    steps:
      - name: Checkout the exact default-branch candidate base
        uses: [[.Actions.Checkout]] # [[index .Versions "checkout"]]
        with:
          ref: ${{ github.sha }}
          persist-credentials: false
[[if .Config.SourceCheckout]]      - name: Fetch private source objects without persisting credentials
        uses: [[.Actions.Checkout]] # [[index .Versions "checkout"]]
        with:
          repository: [[.Config.SourceCheckout.Repository]]
          ref: [[.Config.SourceCheckout.Ref]]
          fetch-depth: 0
          path: .nvkr-inputs/source
          token: ${{ secrets.[[.Config.SourceCheckout.Secret]] }}
          persist-credentials: false
[[end]]      - name: Select the pinned Go toolchain
        uses: [[.Actions.SetupGo]] # [[index .Versions "setup-go"]]
        with:
          go-version-file: .go-version
          cache: true
      - name: Compile the maintenance CLI
        run: go build -trimpath -ldflags '[[.LinkerFlags]]' -o "$RUNNER_TEMP/nvkr" ./cmd/nvkr
      - name: Resolve pins, regenerate and check the candidate
        id: refresh
[[if .Config.SourceCheckout]]        env:
          GIT_CONFIG_COUNT: '1'
          GIT_CONFIG_KEY_0: url.${{ github.workspace }}/.nvkr-inputs/source/.insteadOf
          GIT_CONFIG_VALUE_0: https://github.com/[[.Config.SourceCheckout.Repository]]
[[end]]        run: |
          set -euo pipefail
          "$RUNNER_TEMP/nvkr" catalog refresh --config '[[.ConfigPath]]' --json > "$RUNNER_TEMP/catalog-result.json"
          changed=$(jq -er '.changed | tostring' "$RUNNER_TEMP/catalog-result.json")
          echo "changed=$changed" >> "$GITHUB_OUTPUT"
          cat "$RUNNER_TEMP/catalog-result.json"
      - name: Install pinned lint and validate candidate Go code
        if: steps.refresh.outputs.changed == 'true'
        uses: golangci/golangci-lint-action@ba0d7d2ec06a0ea1cb5fa41b2e4a3ab91d21278a # v9.3.0
        with:
          version: v2.13.1
      - name: Run repository validation
        if: steps.refresh.outputs.changed == 'true'
[[if .Config.SourceCheckout]]        env:
          GIT_CONFIG_COUNT: '1'
          GIT_CONFIG_KEY_0: url.${{ github.workspace }}/.nvkr-inputs/source/.insteadOf
          GIT_CONFIG_VALUE_0: https://github.com/[[.Config.SourceCheckout.Repository]]
[[end]]        run: make check
[[if eq .Config.Validation "local-run"]]      - name: Build and independently observe every candidate output
        if: steps.refresh.outputs.changed == 'true'
        env:
          ATTEMPT: catalog-${{ github.run_id }}-${{ github.run_attempt }}
[[if .Config.SourceCheckout]]          GIT_CONFIG_COUNT: '1'
          GIT_CONFIG_KEY_0: url.${{ github.workspace }}/.nvkr-inputs/source/.insteadOf
          GIT_CONFIG_VALUE_0: https://github.com/[[.Config.SourceCheckout.Repository]]
[[end]]        run: |
          set -euo pipefail
          "$RUNNER_TEMP/nvkr" run local --definition '[[.Config.Definition]]' --environment '[[.Config.Environment]]' --attempt "$ATTEMPT"
[[end]]      - name: Check generation again and prepare the review patch
        if: steps.refresh.outputs.changed == 'true'
[[if .Config.SourceCheckout]]        env:
          GIT_CONFIG_COUNT: '1'
          GIT_CONFIG_KEY_0: url.${{ github.workspace }}/.nvkr-inputs/source/.insteadOf
          GIT_CONFIG_VALUE_0: https://github.com/[[.Config.SourceCheckout.Repository]]
[[end]]        run: |
          set -euo pipefail
          "$RUNNER_TEMP/nvkr" run generate --definition '[[.Config.Definition]]' --environment '[[.Config.Environment]]' --engine github --root . --check
          git diff --check
          git add -- '[[.Config.Catalog]]/pins.lock.yaml' '.github/nvkr-run' '.github/workflows/nvkr-run.yml'
          git diff --cached --check
          git diff --cached --binary -- '[[.Config.Catalog]]/pins.lock.yaml' '.github/nvkr-run' '.github/workflows/nvkr-run.yml' > "$RUNNER_TEMP/catalog-candidate.patch"
          test -s "$RUNNER_TEMP/catalog-candidate.patch"
      - name: Retain the validated review candidate
        if: steps.refresh.outputs.changed == 'true'
        uses: [[.Actions.Upload]] # [[index .Versions "upload-artifact"]]
        with:
          name: catalog-candidate
          path: ${{ runner.temp }}/catalog-candidate.patch
          if-no-files-found: error
          retention-days: 7

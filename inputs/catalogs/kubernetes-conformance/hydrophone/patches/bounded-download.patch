+)
+
+func TestDownloadWriter(t *testing.T) {
+	for _, tc := range []struct {
+		name     string
+		writes   []string
+		want     string
+		overflow bool
+	}{
+		{"empty", []string{""}, "", false},
+		{"below", []string{"abc"}, "abc", false},
+		{"exact", []string{"ab", "cd"}, "abcd", false},
+		{"one over", []string{"abcd", "e"}, "abcd", true},
+		{"one large write", []string{"abcdef"}, "abcd", true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			ctx, cancel := context.WithCancelCause(context.Background())
+			defer cancel(nil)
+			var buf bytes.Buffer
+			w := &downloadWriter{ctx: ctx, cancel: cancel, writer: &buf, remaining: 4}
+			var err error
+			for _, p := range tc.writes {
+				_, err = w.Write([]byte(p))
+			}
+			if buf.String() != tc.want || errors.Is(err, errDownloadLimit) != tc.overflow || errors.Is(context.Cause(ctx), errDownloadLimit) != tc.overflow {
+				t.Fatalf("bytes=%q err=%v cause=%v", buf.String(), err, context.Cause(ctx))
+			}
+			if tc.overflow {
+				if n, err := w.Write([]byte("more")); n != 0 || !errors.Is(err, errDownloadLimit) {
+					t.Fatalf("late overflow write: %d %v", n, err)
+				}
+			}
+		})
+	}
+	for _, tc := range []struct {
+		name   string
+		writer io.Writer
+		want   error
+	}{
+		{"short write", writerFunc(func(p []byte) (int, error) { return len(p) - 1, nil }), io.ErrShortWrite},
+		{"write failure", writerFunc(func([]byte) (int, error) { return 0, io.ErrClosedPipe }), io.ErrClosedPipe},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			ctx, cancel := context.WithCancelCause(context.Background())
+			defer cancel(nil)
+			w := &downloadWriter{ctx: ctx, cancel: cancel, writer: tc.writer, remaining: 4}
+			_, err := w.Write([]byte("abc"))
+			if !errors.Is(err, tc.want) || !errors.Is(context.Cause(ctx), tc.want) {
+				t.Fatalf("error=%v cause=%v", err, context.Cause(ctx))
+			}
+		})
+	}
+}
+
+func TestStreamFileLimits(t *testing.T) {
+	for _, tc := range []struct {
+		name     string
+		stderr   bool
+		size     int64
+		overflow bool
+	}{
+		{"stdout exact", false, maxDownloadBytes, false},
+		{"stdout overflow", false, maxDownloadBytes + 1, true},
+		{"stderr exact", true, maxStderrBytes, false},
+		{"stderr overflow", true, maxStderrBytes + 1, true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+			defer cancel()
+			written := int64(0)
+			out := writerFunc(func(p []byte) (int, error) { written += int64(len(p)); return len(p), nil })
+			executor := streamExecutor(func(ctx context.Context, o remotecommand.StreamOptions) error {
+				w := o.Stdout
+				if tc.stderr {
+					w = o.Stderr
+				}
+				chunk := bytes.Repeat([]byte{'x'}, 1<<20)
+				for remaining := tc.size; remaining > 0; {
+					p := chunk
+					if remaining < int64(len(p)) {
+						p = p[:remaining]
+					}
+					_, _ = w.Write(p) // Match client-go's discarded io.Copy errors.
+					remaining -= int64(len(p))
+				}
+				if tc.overflow {
+					<-ctx.Done()
+					return ctx.Err()
+				}
+				return nil
+			})
+			err := streamFile(ctx, executor, out)
+			if errors.Is(err, errDownloadLimit) != tc.overflow {
+				t.Fatalf("error=%v", err)
+			}
+			want := int64(0)
+			if !tc.stderr {
+				want = maxDownloadBytes
+			}
+			if written != want {
+				t.Fatalf("wrote %d, want %d", written, want)
+			}
+		})
+	}
+}
+
+func TestStreamFileCancellationAndLateWrites(t *testing.T) {
+	t.Run("caller cancellation", func(t *testing.T) {
+		ctx, cancel := context.WithCancelCause(context.Background())
+		cause := errors.New("caller interrupted")
+		cancel(cause)
+		err := streamFile(ctx, streamExecutor(func(ctx context.Context, o remotecommand.StreamOptions) error {
+			if n, err := o.Stdout.Write([]byte("x")); n != 0 || !errors.Is(err, cause) {
+				t.Fatalf("write=%d %v", n, err)
+			}
+			return ctx.Err()
+		}), io.Discard)
+		if !errors.Is(err, cause) {
+			t.Fatalf("lost cause: %v", err)
+		}
+	})
+	t.Run("copy goroutine returns late", func(t *testing.T) {
+		release, done := make(chan struct{}), make(chan struct{})
+		var n int
+		var writeErr error
+		failure := errors.New("stream interrupted")
+		err := streamFile(context.Background(), streamExecutor(func(_ context.Context, o remotecommand.StreamOptions) error {
+			go func() {
+				defer close(done)
+				<-release
+				n, writeErr = o.Stdout.Write([]byte("late"))
+				_, _ = o.Stderr.Write([]byte("late"))
+			}()
+			return failure
+		}), io.Discard)
+		close(release)
+		<-done
+		if !errors.Is(err, failure) || n != 0 || !errors.Is(writeErr, io.ErrClosedPipe) {
+			t.Fatalf("stream=%v late write=%d %v", err, n, writeErr)
+		}
+	})
+}
+
+func TestWriteDownloadedFile(t *testing.T) {
+	failure := errors.New("transfer interrupted")
+	for _, tc := range []struct {
+		name     string
+		transfer func(context.CancelCauseFunc, io.Writer) error
+		want     error
+	}{
+		{"success", func(_ context.CancelCauseFunc, w io.Writer) error {
+			_, err := io.WriteString(w, "original")
+			return err
+		}, nil},
+		{"failed transfer", func(_ context.CancelCauseFunc, w io.Writer) error {
+			_, _ = io.WriteString(w, "partial")
+			return failure
+		}, failure},
+		{"overflow", func(_ context.CancelCauseFunc, w io.Writer) error {
+			_, _ = io.WriteString(w, "partial")
+			return errDownloadLimit
+		}, errDownloadLimit},
+		{"write failure", func(_ context.CancelCauseFunc, w io.Writer) error {
+			_ = w.(io.Closer).Close()
+			_, err := io.WriteString(w, "partial")
+			return err
+		}, os.ErrClosed},
+		{"close failure", func(_ context.CancelCauseFunc, w io.Writer) error {
+			_, _ = io.WriteString(w, "partial")
+			return w.(io.Closer).Close()
+		}, os.ErrClosed},
+		{"canceled transfer", func(cancel context.CancelCauseFunc, w io.Writer) error {
+			_, _ = io.WriteString(w, "partial")
+			cancel(failure)
+			return nil
+		}, failure},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			dir := t.TempDir()
+			dest := filepath.Join(dir, "junit_01.xml")
+			ctx, cancel := context.WithCancelCause(context.Background())
+			defer cancel(nil)
+			err := writeDownloadedFile(ctx, dest, func(_ context.Context, w io.Writer) error { return tc.transfer(cancel, w) })
+			if !errors.Is(err, tc.want) {
+				t.Fatalf("error=%v want=%v", err, tc.want)
+			}
+			entries, err := os.ReadDir(dir)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if tc.want != nil {
+				if len(entries) != 0 {
+					t.Fatalf("failed transfer left files: %v", entries)
+				}
+				return
+			}
+			if len(entries) != 1 || entries[0].Name() != "junit_01.xml" {
+				t.Fatalf("unexpected files: %v", entries)
+			}
+			data, err := os.ReadFile(dest)
+			if err != nil {
+				t.Fatal(err)
+			}
+			info, err := os.Stat(dest)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if string(data) != "original" || info.Mode().Perm() != 0600 {
+				t.Fatalf("data=%q mode=%v", data, info.Mode())
+			}
+		})
+	}
+}
+
+type writerFunc func([]byte) (int, error)
+
+func (f writerFunc) Write(p []byte) (int, error) { return f(p) }
+
+type streamExecutor func(context.Context, remotecommand.StreamOptions) error
+
+func (f streamExecutor) Stream(o remotecommand.StreamOptions) error {
+	return f(context.Background(), o)
+}
+func (f streamExecutor) StreamWithContext(ctx context.Context, o remotecommand.StreamOptions) error {
+	return f(ctx, o)
+}

+
+const (
+	maxDownloadBytes = 64 << 20
+	maxStderrBytes   = 1 << 20
+)
+
+var errDownloadLimit = errors.New("download byte limit exceeded")
+
+// writeDownloadedFile exposes only a successfully transferred and closed file.
+func writeDownloadedFile(ctx context.Context, dest string, download func(context.Context, io.Writer) error) error {
+	file, err := os.CreateTemp(filepath.Dir(dest), "."+filepath.Base(dest)+"-*")
+	if err != nil {
+		return err
+	}
+	defer os.Remove(file.Name())
+	defer file.Close()
+	if err := download(ctx, file); err != nil {
+		return err
+	}
+	if err := file.Close(); err != nil {
+		return err
+	}
+	if err := context.Cause(ctx); err != nil {
+		return err
+	}
+	return os.Rename(file.Name(), dest)
+}
+
+func streamFile(ctx context.Context, executor remotecommand.Executor, writer io.Writer) error {
+	ctx, cancel := context.WithCancelCause(ctx)
+	defer cancel(nil)
+	var stderr bytes.Buffer
+	stdoutBudget := &downloadWriter{ctx: ctx, cancel: cancel, writer: writer, remaining: maxDownloadBytes}
+	stderrBudget := &downloadWriter{ctx: ctx, cancel: cancel, writer: &stderr, remaining: maxStderrBytes}
+	err := executor.StreamWithContext(ctx, remotecommand.StreamOptions{Stdout: stdoutBudget, Stderr: stderrBudget})
+	// client-go may return on cancellation while copy goroutines still hold the
+	// writers. Stop both before the file is closed or stderr is inspected.
+	stdoutBudget.stop()
+	stderrBudget.stop()
+	if cause := context.Cause(ctx); cause != nil {
+		return fmt.Errorf("download failed: %w", cause)
+	}
+	if err != nil {
+		return fmt.Errorf("download failed: %w (stderr: %s)", err, strings.TrimSpace(stderr.String()))
+	}
+	return nil
+}
+
+// StreamOptions requires writers; LimitReader cannot bound these streams.
+// Cancel on write failures because client-go can discard io.Copy errors.
+type downloadWriter struct {
+	mu        sync.Mutex
+	ctx       context.Context
+	cancel    context.CancelCauseFunc
+	writer    io.Writer
+	remaining int64
+	stopped   bool
+}
+
+func (w *downloadWriter) Write(p []byte) (int, error) {
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	if w.stopped {
+		return 0, io.ErrClosedPipe
+	}
+	if err := context.Cause(w.ctx); err != nil {
+		return 0, err
+	}
+	overflow := int64(len(p)) > w.remaining
+	if overflow {
+		p = p[:int(w.remaining)]
+	}
+	n, err := w.writer.Write(p)
+	w.remaining -= int64(n)
+	if err == nil && n != len(p) {
+		err = io.ErrShortWrite
+	}
+	if err == nil && overflow {
+		err = errDownloadLimit
+	}
+	if err != nil {
+		w.cancel(err)
+	}
+	return n, err
+}
+
+func (w *downloadWriter) stop() {
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	w.stopped = true
+}

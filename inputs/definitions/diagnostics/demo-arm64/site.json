{
  "apiVersion": "nvkr.dev/definition/v5",
  "catalog": {
    "base": "../../../catalogs/nvke/local-site-arm64"
  },
  "kind": "Definition",
  "metadata": {
    "name": "nvke-local-site-artifacts-arm64",
    "description": "Five source-aligned staged-installer artifacts including the native diagnostic profiles image. Build-only candidate; no OS, complete dependency mirror, deployment or signing claim."
  },
  "outputs": [
    {
      "components": [
        "nvke-controller-chart"
      ],
      "format": "helm-oci",
      "helm": {
        "images": {
          "controller": "nvke-controller"
        }
      },
      "name": "controller-chart",
      "platform": "linux/arm64"
    },
    {
      "catalog": {
        "base": "../../../catalogs/controller-profiles/nvidia-arm64"
      },
      "components": [
        "nvke-local-profiles"
      ],
      "format": "oci",
      "name": "controller-profiles",
      "platform": "linux/arm64"
    },
    {
      "components": [
        "nktp-chart"
      ],
      "format": "helm-oci",
      "name": "nktp",
      "platform": "linux/arm64"
    },
    {
      "components": [
        "nvke-controller"
      ],
      "format": "oci",
      "name": "nvke-controller",
      "platform": "linux/arm64"
    },
    {
      "components": [
        "nvkectl"
      ],
      "format": "executable",
      "name": "nvkectl",
      "platform": "linux/arm64"
    }
  ]
}

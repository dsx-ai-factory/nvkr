{
  "apiVersion": "nvkr.dev/definition/v5",
  "catalog": {
    "base": "../../../catalogs/nvke"
  },
  "kind": "Definition",
  "metadata": {
    "description": "Five source-aligned staged-installer artifacts including the native diagnostic profiles image. Build-only candidate; no OS, complete dependency mirror, deployment or signing claim.",
    "name": "nvke-local-site-artifacts-arm64"
  },
  "outputs": [
    {
      "components": [
        "nvke-controller-chart-local-site"
      ],
      "format": "helm-oci",
      "helm": {
        "images": {
          "controller": "cwe"
        }
      },
      "name": "controller-chart",
      "platform": "linux/arm64"
    },
    {
      "catalog": {
        "base": "../../../catalogs/nvke"
      },
      "components": [
        "nvke-local-profiles-nvidia"
      ],
      "format": "oci",
      "name": "controller-profiles",
      "platform": "linux/arm64"
    },
    {
      "components": [
        "nvke-controller-local-site"
      ],
      "format": "oci",
      "name": "cwe",
      "platform": "linux/arm64"
    },
    {
      "components": [
        "nktp-chart"
      ],
      "format": "helm-oci",
      "name": "nktp",
      "platform": "linux/arm64"
    },
    {
      "components": [
        "nvkectl-local-site"
      ],
      "format": "executable",
      "name": "nvkectl",
      "platform": "linux/arm64"
    }
  ]
}

{
  "apiVersion": "nvkr.dev/environment/v1",
  "kind": "Environment",
  "metadata": {
    "name": "nvke-native-mac-source-local"
  },
  "utilityContainer": "golang@sha256:08bcb99a38f85a265f9a93d1d3323e2440eec333380f3ea26ee0dec9264bb41c",
  "utilityPlatform": "linux/arm64",
  "executionClasses": [
    {
      "name": "native-mac-hvf",
      "runsOn": "local-mac-hvf",
      "hostPlatform": "darwin/arm64",
      "capabilities": ["hvf"],
      "resources": {
        "cpuMillis": 8000,
        "memoryMiB": 10240,
        "ephemeralStorageMiB": 65536
      },
      "maxTimeoutSeconds": 21600
    },
    {
      "name": "native-mac-tcg",
      "runsOn": "local-mac-tcg",
      "hostPlatform": "darwin/arm64",
      "resources": {
        "cpuMillis": 8000,
        "memoryMiB": 10240,
        "ephemeralStorageMiB": 65536
      },
      "maxTimeoutSeconds": 21600
    }
  ],
  "runtime": {
    "runtime": "docker"
  },
  "toolchainAccess": {
    "publicRoots": [
      "docker.io/library/alpine",
      "docker.io/library/golang",
      "docker.io/moby/buildkit"
    ]
  }
}
